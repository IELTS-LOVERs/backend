# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/ielts_db

# JWT
# BẮT BUỘC đổi trước khi deploy; mỗi secret phải là chuỗi ≥ 32 ký tự ngẫu nhiên
# và KHÁC NHAU. Sinh bằng: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# MinIO / SeaweedFS
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ielts-media
PUBLIC_MEDIA_URL=http://localhost:9000/ielts-media

# Host/port embedded in presigned URLs (used by the BROWSER).
# Để trống = ký bằng MINIO_ENDPOINT ở trên (dev). Production qua tunnel/domain
# public thì set ví dụ: MINIO_PUBLIC_ENDPOINT=media.example.com, PORT=443, SSL=true
# MINIO_PUBLIC_ENDPOINT=media.example.com
# MINIO_PUBLIC_PORT=443
# MINIO_PUBLIC_USE_SSL=true

# Số hop proxy tin cậy đứng trước API (Cloudflare Tunnel/nginx = 1).
# Đặt 0 nếu API có thể bị truy cập trực tiếp (không proxy) — tránh spoof X-Forwarded-For.
TRUST_PROXY_HOPS=1

# Exam Engine
EXAM_GRACE_PERIOD_SECONDS=15
# When true, students must start an attempt through a valid assignment.
REQUIRE_ASSIGNMENT_FOR_ATTEMPT=false

# Anti-cheat thresholds
ANTI_CHEAT_TAB_SWITCH_THRESHOLD=5
ANTI_CHEAT_FULLSCREEN_EXIT_THRESHOLD=2
ANTI_CHEAT_PASTE_THRESHOLD=3
